{
  "name": "allgames",
  "version": "0.1.0",
  "description": "All Games - A collection of browser-based games",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/games/*"
  ],
  "scripts": {
    "start": "npm run dev -w @allgames/shell",
    "dev": "npm run dev -w @allgames/shell",
    "build": "npm run build -w @allgames/shell",
    "typecheck": "tsc -b apps/shell",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "preview": "npm run preview -w @allgames/shell",
    "test": "vitest run packages/games",
    "install-all": "npm install"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.0.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.5.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.24.0",
    "vitest": "^5.0.0"
  }
}
