{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@allgames/tic-tac-toe": ["../../packages/games/tic-tac-toe/src/index.ts"],
      "@allgames/snake": ["../../packages/games/snake/src/index.ts"],
      "@allgames/checkers": ["../../packages/games/checkers/src/index.tsx"],
      "@allgames/chess": ["../../packages/games/chess/src/index.tsx"],
      "@allgames/minesweeper": ["../../packages/games/minesweeper/src/index.tsx"],
      "@allgames/2048": ["../../packages/games/2048/src/index.tsx"],
      "@allgames/memory": ["../../packages/games/memory/src/index.tsx"],
      "@allgames/sudoku": ["../../packages/games/sudoku/src/index.tsx"],
      "@allgames/battleship": ["../../packages/games/battleship/src/index.tsx"],
      "@allgames/solitaire": ["../../packages/games/solitaire/src/index.tsx"],
      "@allgames/ui": ["../../packages/ui/src/index.ts"]
    }
  },
  "include": ["src", "../../packages/games/*/src", "../../packages/ui/src"]
}
