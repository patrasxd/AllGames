+/* ─── Canvas Container & Wrapper (Aspect Preserving) ───────── */
+.bs-canvas-container {
+  width: 100%;
+  height: 100%;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  outline: none;
+  cursor: crosshair;
+  overflow: hidden;
+  -webkit-tap-highlight-color: transparent;
+  touch-action: none;
+}
+
+.bs-canvas-wrapper {
+  position: relative;
+  width: 100%;
+  height: 100%;
+  display: block;
+  overflow: hidden;
+  cursor: crosshair;
+  touch-action: none;
+  -webkit-touch-callout: none;
+  -webkit-tap-highlight-color: transparent;
+}
+
+.bs-canvas {
+  width: 100%;
+  height: 100%;
+  max-width: 100%;
+  max-height: 100%;
+  object-fit: contain;
+  display: block;
+}
+
+/* ─── Controls Bar ────────────────────────────────────────── */
+.bs-footer-bar {
+  flex-wrap: wrap;
+  justify-content: center;
+}
+
+/* On-screen aim/fire buttons: only on touch devices, where there is no mouse to click with. */
+.bs-touch-controls {
+  display: none;
+  align-items: center;
+  justify-content: center;
+  gap: var(--all-space-3, 0.75rem);
+  width: 100%;
+  margin-bottom: var(--all-space-2, 0.5rem);
+  touch-action: none;
+  user-select: none;
+  -webkit-user-select: none;
+}
+
+.bs-touch-controls .all-btn {
+  touch-action: none;
+}
+
+.bs-fire-btn {
+  flex: 1;
+  max-width: 11rem;
